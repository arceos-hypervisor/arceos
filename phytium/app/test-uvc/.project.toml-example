[compile]
target = "aarch64-unknown-none-softfloat"

[compile.build.Custom]
shell = ["make A=phytium/app/test-uvc LD_SCRIPT=link.x FEATURES=driver-dyn LOG=info MYPLAT=axplat-aarch64-dyn"]
kernel = "phytium/app/test-uvc/test-uvc_aarch64-dyn.bin"

[qemu]
machine = "virt"
cpu = "cortex-a57"
graphic = false
args = ""

[uboot]
serial = "/dev/ttyUSB0"
baud_rate = 115200
dtb_file = "phytium/phytium.dtb"
